{
  "name": "nightmesh",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "publisher": "MBKDevStudio",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mbKalkan/nightmesh.git"
  },
  "homepage": "https://github.com/mbKalkan/nightmesh#readme",
  "bugs": {
    "url": "https://github.com/mbKalkan/nightmesh/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "gltf",
    "glb",
    "3d",
    "3d model",
    "viewer"
  ],
  "preview": true,
  "pricing": "Free",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "glb",
        "aliases": [
          "glTF Binary"
        ],
        "extensions": [
          ".glb"
        ]
      },
      {
        "id": "json",
        "extensions": [
          ".gltf"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "nightmesh.viewer",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.glb"
          },
          {
            "filenamePattern": "*.gltf"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "files": [
    "dist/**",
    "l10n/**",
    "package.nls*.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.extension.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.json",
    "lint": "eslint src scripts test",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "test": "vitest run",
    "test:visual": "node scripts/build.mjs && playwright test",
    "test:smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "fixtures:large": "node scripts/gen-fixtures.mjs --large",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "draco3dgltf": "^1.5.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
