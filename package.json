{
  "name": "nightmesh",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "MBKDevStudio",
  "icon": "assets/icon.png",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mbKalkan/nightmesh.git"
  },
  "homepage": "https://github.com/mbKalkan/nightmesh#readme",
  "bugs": {
    "url": "https://github.com/mbKalkan/nightmesh/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "gltf",
    "glb",
    "gltf viewer",
    "glb viewer",
    "3d model viewer",
    "3d viewer",
    "3d model",
    "model viewer",
    "3d",
    "mesh viewer",
    "gltf inspector",
    "glb inspector",
    "gltf 2.0",
    "three.js",
    "threejs",
    "draco",
    "meshopt",
    "ktx2",
    "basis universal",
    "pbr",
    "animation",
    "scene graph",
    "wireframe",
    "triangle count",
    "materials",
    "textures",
    "khronos",
    "game assets",
    "digital twin",
    "offline"
  ],
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#22122b",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "glb",
        "aliases": [
          "glTF Binary"
        ],
        "extensions": [
          ".glb"
        ]
      },
      {
        "id": "json",
        "extensions": [
          ".gltf"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "nightmesh.viewer",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.glb"
          },
          {
            "filenamePattern": "*.gltf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "nightmesh.copyReference",
        "title": "%command.copyReference%",
        "category": "%category%"
      },
      {
        "command": "nightmesh.copyReferenceWithDetails",
        "title": "%command.copyReferenceWithDetails%",
        "category": "%category%"
      },
      {
        "command": "nightmesh.showJson",
        "title": "%command.showJson%",
        "category": "%category%"
      },
      {
        "command": "nightmesh.saveScreenshot",
        "title": "%command.saveScreenshot%",
        "category": "%category%"
      },
      {
        "command": "nightmesh.saveReport",
        "title": "%command.saveReport%",
        "category": "%category%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nightmesh.copyReference",
          "when": "activeCustomEditorId == nightmesh.viewer"
        },
        {
          "command": "nightmesh.copyReferenceWithDetails",
          "when": "activeCustomEditorId == nightmesh.viewer"
        },
        {
          "command": "nightmesh.showJson",
          "when": "activeCustomEditorId == nightmesh.viewer"
        },
        {
          "command": "nightmesh.saveScreenshot",
          "when": "activeCustomEditorId == nightmesh.viewer"
        },
        {
          "command": "nightmesh.saveReport",
          "when": "activeCustomEditorId == nightmesh.viewer"
        }
      ],
      "webview/context": [
        {
          "command": "nightmesh.copyReference",
          "when": "webviewId == 'nightmesh.viewer'",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "nightmesh.copyReferenceWithDetails",
          "when": "webviewId == 'nightmesh.viewer'",
          "group": "9_cutcopypaste@2"
        },
        {
          "command": "nightmesh.showJson",
          "when": "webviewId == 'nightmesh.viewer'",
          "group": "navigation@1"
        }
      ]
    }
  },
  "files": [
    "dist/**",
    "assets/icon.png",
    "l10n/**",
    "package.nls*.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.extension.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.json",
    "lint": "eslint src scripts test",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "test": "vitest run",
    "test:visual": "node scripts/build.mjs && playwright test",
    "test:smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "fixtures:large": "node scripts/gen-fixtures.mjs --large",
    "screenshots": "node scripts/screenshots.mjs",
    "demo": "node scripts/demo.mjs",
    "icon": "node scripts/render-icon.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "draco3dgltf": "^1.5.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "gltf-validator": "^2.0.0-dev.3.10",
    "three": "^0.186.1"
  }
}
