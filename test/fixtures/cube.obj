# Nightmesh fixture generator
# A box of two materials on a ground plane, with its top edges as lines.
mtllib cube.mtl
o Box
v -0.5 0 0.5
v 0.5 0 0.5
v 0.5 1 0.5
v -0.5 1 0.5
v -0.5 0 -0.5
v 0.5 0 -0.5
v 0.5 1 -0.5
v -0.5 1 -0.5
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 1
vn 0 0 -1
vn 1 0 0
vn -1 0 0
vn 0 1 0
vn 0 -1 0
s off
usemtl Checker
f 1/1/1 2/2/1 3/3/1 4/4/1
f 4/1/5 3/2/5 7/3/5 8/4/5
usemtl Painted
f 6/1/2 5/2/2 8/3/2 7/4/2
f 2/1/3 6/2/3 7/3/3 3/4/3
f 5/1/4 1/2/4 4/3/4 8/4/4
f 5/1/6 6/2/6 2/3/6 1/4/6
o Ground
v -1.5 -0.01 1.5
v 1.5 -0.01 1.5
v 1.5 -0.01 -1.5
v -1.5 -0.01 -1.5
usemtl Grass
f 9/1/5 10/2/5 11/3/5 12/4/5
o Outline
l 4 3 7 8 4
